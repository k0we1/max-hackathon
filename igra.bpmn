<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_ToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.29.0">
  <bpmn:collaboration id="Collaboration_ToBe_Game">
    <bpmn:participant id="Participant_Players" name="Игроки в чате MAX" processRef="Process_Players" />
    <bpmn:participant id="Participant_ChatBot" name="Чат-бот MAX" processRef="Process_ChatBot" />
    <bpmn:participant id="Participant_MiniApp" name="Мини-приложение" processRef="Process_MiniApp" />
    <bpmn:participant id="Participant_Backend" name="Backend продукта" processRef="Process_Backend" />
    <bpmn:messageFlow id="MsgFlow_4" name="" sourceRef="Task_SendOpenButton" targetRef="Event_MiniAppStart" />
    <bpmn:messageFlow id="MsgFlow_5" name="" sourceRef="Task_StartSession" targetRef="Event_BackendStart" />
    <bpmn:messageFlow id="MsgFlow_6" name="" sourceRef="Task_BackendCreateSession" targetRef="SubProcess_GameCycle" />
    <bpmn:messageFlow id="MsgFlow_7" name="" sourceRef="Task_MarkCardDiscussed" targetRef="Task_BackendFixCard" />
    <bpmn:messageFlow id="MsgFlow_8" name="" sourceRef="Task_FormResults" targetRef="Task_ShowResults" />
    <bpmn:messageFlow id="MsgFlow_9" name="" sourceRef="Task_ShowResults" targetRef="Event_ResultsReceived" />
    <bpmn:messageFlow id="MsgFlow_10" name="" sourceRef="Task_BotOfferReminder" targetRef="Task_SetReminder" />
    <bpmn:messageFlow id="Flow_0nsdqdj" sourceRef="Activity_0smljod" targetRef="Event_BotStart" />
    <bpmn:textAnnotation id="Annotation_1">
      <bpmn:text>Готовые колоды: вопросы не нужно придумывать</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="Task_OpenCatalog" targetRef="Annotation_1" />
    <bpmn:textAnnotation id="Annotation_2">
      <bpmn:text>Итоги и историю встреч сохраняет backend</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_2" sourceRef="Task_FormResults" targetRef="Annotation_2" />
    <bpmn:textAnnotation id="Annotation_3">
      <bpmn:text>Нет правильных ответов: карточки для обсуждения, а не экзамен</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_3" sourceRef="Task_ShowCard" targetRef="Annotation_3" />
    <bpmn:textAnnotation id="Annotation_4">
      <bpmn:text>Напоминания возвращают игроков в продукт</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_4" sourceRef="Task_SetReminder" targetRef="Annotation_4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Players" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Players">
      <bpmn:lane id="Lane_Initiator" name="Инициатор" />
      <bpmn:lane id="Lane_Participants" name="Участники" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_Start" name="Игрок отправляет /start">
      <bpmn:outgoing>Flow_07ozq5z</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_DiscussToEnd" sourceRef="Task_PlayersDiscuss" targetRef="Event_PlayersEnd" />
    <bpmn:userTask id="Activity_0smljod" name="Режим карточек">
      <bpmn:incoming>Flow_07ozq5z</bpmn:incoming>
      <bpmn:outgoing>Flow_01n4m2w</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_07ozq5z" sourceRef="Event_Start" targetRef="Activity_0smljod" />
    <bpmn:userTask id="Task_PlayersDiscuss" name="Игроки обсуждают карточки">
      <bpmn:incoming>Flow_01n4m2w</bpmn:incoming>
      <bpmn:outgoing>Flow_DiscussToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_01n4m2w" sourceRef="Activity_0smljod" targetRef="Task_PlayersDiscuss" />
    <bpmn:endEvent id="Event_PlayersEnd" name="Завершили обсуждение">
      <bpmn:incoming>Flow_DiscussToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_ChatBot" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_BotStartToWelcome" sourceRef="Event_BotStart" targetRef="Task_BotWelcome" />
    <bpmn:sequenceFlow id="Flow_WelcomeToAsk" sourceRef="Task_BotWelcome" targetRef="Task_SendOpenButton" />
    <bpmn:sequenceFlow id="Flow_OpenToWait" sourceRef="Task_SendOpenButton" targetRef="Event_ResultsReceived" />
    <bpmn:sequenceFlow id="Flow_ResultsToNotify" sourceRef="Event_ResultsReceived" targetRef="Task_BotNotifyResult" />
    <bpmn:sequenceFlow id="Flow_NotifyToReminder" sourceRef="Task_BotNotifyResult" targetRef="Task_BotOfferReminder" />
    <bpmn:sequenceFlow id="Flow_OfferToGateway" sourceRef="Task_BotOfferReminder" targetRef="Gateway_ReminderAgreed" />
    <bpmn:sequenceFlow id="Flow_ReminderYes" name="Да" sourceRef="Gateway_ReminderAgreed" targetRef="Event_ReminderSet">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reminder == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReminderNo" name="Нет" sourceRef="Gateway_ReminderAgreed" targetRef="Event_GameComplete" />
    <bpmn:task id="Task_BotWelcome" name="Приветствие">
      <bpmn:incoming>Flow_BotStartToWelcome</bpmn:incoming>
      <bpmn:outgoing>Flow_WelcomeToAsk</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="Event_BotStart" name="Получен /cards">
      <bpmn:outgoing>Flow_BotStartToWelcome</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="Task_SendOpenButton" name="Отправить кнопку &#34;Открыть игру&#34;">
      <bpmn:incoming>Flow_WelcomeToAsk</bpmn:incoming>
      <bpmn:outgoing>Flow_OpenToWait</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_ResultsReceived" name="Получены итоги встречи">
      <bpmn:incoming>Flow_OpenToWait</bpmn:incoming>
      <bpmn:outgoing>Flow_ResultsToNotify</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_BotNotifyResult" name="Уведомление в чат с итогом и кнопкой &#34;Поделиться&#34;">
      <bpmn:incoming>Flow_ResultsToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyToReminder</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_BotOfferReminder" name="Предложить напомнить поиграть завтра">
      <bpmn:incoming>Flow_NotifyToReminder</bpmn:incoming>
      <bpmn:outgoing>Flow_OfferToGateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ReminderAgreed" name="Согласие на напоминание?" default="Flow_ReminderNo">
      <bpmn:incoming>Flow_OfferToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ReminderYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReminderNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_ReminderSet" name="Напоминание установлено">
      <bpmn:incoming>Flow_ReminderYes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_GameComplete" name="Игра завершена">
      <bpmn:incoming>Flow_ReminderNo</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_MiniApp" isExecutable="false">
    <bpmn:startEvent id="Event_MiniAppStart" name="Открыт мини-апп">
      <bpmn:outgoing>Flow_MiniAppStartToCatalog</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="Task_OpenCatalog" name="Открыть каталог колод">
      <bpmn:incoming>Flow_MiniAppStartToCatalog</bpmn:incoming>
      <bpmn:outgoing>Flow_CatalogToFilters</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApplyFilters" name="Применить фильтры (тема, настроение, язык)">
      <bpmn:incoming>Flow_CatalogToFilters</bpmn:incoming>
      <bpmn:outgoing>Flow_FiltersToSelect</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SelectDeck" name="Выбрать колоду">
      <bpmn:incoming>Flow_FiltersToSelect</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectToStart</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_StartSession" name="Старт сессии">
      <bpmn:incoming>Flow_SelectToStart</bpmn:incoming>
      <bpmn:incoming>Flow_ReturnFromExit</bpmn:incoming>
      <bpmn:outgoing>Flow_StartToGameCycle</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ShowResults" name="Экран &#34;Итоги встречи&#34;">
      <bpmn:incoming>Flow_GameCycleToResults</bpmn:incoming>
      <bpmn:outgoing>Flow_ResultsEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_MiniAppEnd" name="Завершено">
      <bpmn:incoming>Flow_ResultsEnd</bpmn:incoming>
      <bpmn:incoming>Flow_PauseToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_SaveProgress" name="Сохранить прогресс сессии">
      <bpmn:incoming>Flow_ExitToSave</bpmn:incoming>
      <bpmn:outgoing>Flow_SaveToDeepLink</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DeepLinkReturn" name="Возврат по глубокой ссылке">
      <bpmn:incoming>Flow_SaveToDeepLink</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnFromExit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PauseSession" name="Приостановить сессию">
      <bpmn:incoming>Flow_TimeoutToPause</bpmn:incoming>
      <bpmn:outgoing>Flow_PauseToEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Boundary_Timeout" name="Неактивность &#62; 10 мин">
      <bpmn:outgoing>Flow_TimeoutToPause</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_14n6p9w" />
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="SubProcess_GameCycle" name="Игровой цикл">
      <bpmn:incoming>Flow_StartToGameCycle</bpmn:incoming>
      <bpmn:outgoing>Flow_GameCycleToResults</bpmn:outgoing>
      <bpmn:startEvent id="Event_CycleStart" name="Начало раунда">
        <bpmn:outgoing>Flow_CycleStartToShowCard</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Task_ShowCard" name="Показать карточку-вопрос">
        <bpmn:incoming>Flow_CycleStartToShowCard</bpmn:incoming>
        <bpmn:incoming>Flow_NextCardYes</bpmn:incoming>
        <bpmn:outgoing>Flow_ShowCardToMark</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_MarkCardDiscussed" name="Отметить карточку обсуждённой">
        <bpmn:incoming>Flow_ShowCardToMark</bpmn:incoming>
        <bpmn:outgoing>Flow_MarkToPenaltyCheck</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_PenaltyActive" name="Штрафная механика активна?" default="Flow_PenaltyNo">
        <bpmn:incoming>Flow_MarkToPenaltyCheck</bpmn:incoming>
        <bpmn:outgoing>Flow_PenaltyYes</bpmn:outgoing>
        <bpmn:outgoing>Flow_PenaltyNo</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Task_ShowPenalty" name="Показать штрафное задание">
        <bpmn:incoming>Flow_PenaltyYes</bpmn:incoming>
        <bpmn:outgoing>Flow_PenaltyToJoin</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_PenaltyJoin" name="">
        <bpmn:incoming>Flow_PenaltyNo</bpmn:incoming>
        <bpmn:incoming>Flow_PenaltyToJoin</bpmn:incoming>
        <bpmn:outgoing>Flow_PenaltyJoinToNextCheck</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Gateway_HasNextCard" name="Есть следующая карточка?" default="Flow_NoMoreCards">
        <bpmn:incoming>Flow_PenaltyJoinToNextCheck</bpmn:incoming>
        <bpmn:outgoing>Flow_NextCardYes</bpmn:outgoing>
        <bpmn:outgoing>Flow_NoMoreCards</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="Event_CycleComplete" name="Все карточки обсуждены">
        <bpmn:incoming>Flow_NoMoreCards</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_CycleStartToShowCard" sourceRef="Event_CycleStart" targetRef="Task_ShowCard" />
      <bpmn:sequenceFlow id="Flow_ShowCardToMark" sourceRef="Task_ShowCard" targetRef="Task_MarkCardDiscussed" />
      <bpmn:sequenceFlow id="Flow_MarkToPenaltyCheck" sourceRef="Task_MarkCardDiscussed" targetRef="Gateway_PenaltyActive" />
      <bpmn:sequenceFlow id="Flow_PenaltyYes" name="Да" sourceRef="Gateway_PenaltyActive" targetRef="Task_ShowPenalty">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${penaltyEnabled == true}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_PenaltyNo" name="Нет" sourceRef="Gateway_PenaltyActive" targetRef="Gateway_PenaltyJoin" />
      <bpmn:sequenceFlow id="Flow_PenaltyToJoin" sourceRef="Task_ShowPenalty" targetRef="Gateway_PenaltyJoin" />
      <bpmn:sequenceFlow id="Flow_PenaltyJoinToNextCheck" sourceRef="Gateway_PenaltyJoin" targetRef="Gateway_HasNextCard" />
      <bpmn:sequenceFlow id="Flow_NextCardYes" name="Да" sourceRef="Gateway_HasNextCard" targetRef="Task_ShowCard">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasNextCard == true}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_NoMoreCards" name="Нет" sourceRef="Gateway_HasNextCard" targetRef="Event_CycleComplete" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_PlayerExit" name="Игрок вышел" cancelActivity="false" attachedToRef="SubProcess_GameCycle">
      <bpmn:outgoing>Flow_ExitToSave</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_MiniAppStartToCatalog" sourceRef="Event_MiniAppStart" targetRef="Task_OpenCatalog" />
    <bpmn:sequenceFlow id="Flow_CatalogToFilters" sourceRef="Task_OpenCatalog" targetRef="Task_ApplyFilters" />
    <bpmn:sequenceFlow id="Flow_FiltersToSelect" sourceRef="Task_ApplyFilters" targetRef="Task_SelectDeck" />
    <bpmn:sequenceFlow id="Flow_SelectToStart" sourceRef="Task_SelectDeck" targetRef="Task_StartSession" />
    <bpmn:sequenceFlow id="Flow_ReturnFromExit" sourceRef="Task_DeepLinkReturn" targetRef="Task_StartSession" />
    <bpmn:sequenceFlow id="Flow_StartToGameCycle" sourceRef="Task_StartSession" targetRef="SubProcess_GameCycle" />
    <bpmn:sequenceFlow id="Flow_GameCycleToResults" sourceRef="SubProcess_GameCycle" targetRef="Task_ShowResults" />
    <bpmn:sequenceFlow id="Flow_ResultsEnd" sourceRef="Task_ShowResults" targetRef="Event_MiniAppEnd" />
    <bpmn:sequenceFlow id="Flow_PauseToEnd" sourceRef="Task_PauseSession" targetRef="Event_MiniAppEnd" />
    <bpmn:sequenceFlow id="Flow_ExitToSave" sourceRef="Boundary_PlayerExit" targetRef="Task_SaveProgress" />
    <bpmn:sequenceFlow id="Flow_SaveToDeepLink" sourceRef="Task_SaveProgress" targetRef="Task_DeepLinkReturn" />
    <bpmn:sequenceFlow id="Flow_TimeoutToPause" sourceRef="Boundary_Timeout" targetRef="Task_PauseSession" />
  </bpmn:process>
  <bpmn:process id="Process_Backend" isExecutable="false">
    <bpmn:startEvent id="Event_BackendStart" name="Запрос на создание сессии">
      <bpmn:outgoing>Flow_BackendStartToCreate</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="Task_BackendCreateSession" name="Создать сессию и вернуть колоду">
      <bpmn:incoming>Flow_BackendStartToCreate</bpmn:incoming>
      <bpmn:outgoing>Flow_SessionCreated</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_BackendFixCard" name="Зафиксировать обсуждённую карточку">
      <bpmn:incoming>Flow_SessionCreated</bpmn:incoming>
      <bpmn:outgoing>Flow_FixToFormResults</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FormResults" name="Сформировать итоги встречи">
      <bpmn:incoming>Flow_FixToFormResults</bpmn:incoming>
      <bpmn:outgoing>Flow_ResultsToReminder</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SetReminder" name="Установить ежедневное напоминание">
      <bpmn:incoming>Flow_ResultsToReminder</bpmn:incoming>
      <bpmn:outgoing>Flow_ReminderToEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_BackendEnd" name="Завершено">
      <bpmn:incoming>Flow_ReminderToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_BackendStartToCreate" sourceRef="Event_BackendStart" targetRef="Task_BackendCreateSession" />
    <bpmn:sequenceFlow id="Flow_SessionCreated" sourceRef="Task_BackendCreateSession" targetRef="Task_BackendFixCard" />
    <bpmn:sequenceFlow id="Flow_FixToFormResults" sourceRef="Task_BackendFixCard" targetRef="Task_FormResults" />
    <bpmn:sequenceFlow id="Flow_ResultsToReminder" sourceRef="Task_FormResults" targetRef="Task_SetReminder" />
    <bpmn:sequenceFlow id="Flow_ReminderToEnd" sourceRef="Task_SetReminder" targetRef="Event_BackendEnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_ToBe_Game">
    <bpmndi:BPMNPlane id="BPMNPlane_Collaboration_ToBe_Game" bpmnElement="Collaboration_ToBe_Game">
      <bpmndi:BPMNShape id="Participant_Players_di" bpmnElement="Participant_Players" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1210" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Start_di" bpmnElement="Event_Start" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="220" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel color:color="#6b3c00">
          <dc:Bounds x="193" y="94" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0smljod_di" bpmnElement="Activity_0smljod" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="310" y="110" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0l1ns2y_di" bpmnElement="Task_PlayersDiscuss" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="480" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_PlayersEnd_di" bpmnElement="Event_PlayersEnd" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="622" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="609" y="168" width="62" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_DiscussToEnd_di" bpmnElement="Flow_DiscussToEnd" bioc:stroke="#831311" color:border-color="#831311">
        <di:waypoint x="580" y="150" />
        <di:waypoint x="622" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07ozq5z_di" bpmnElement="Flow_07ozq5z" bioc:stroke="#6b3c00" color:border-color="#6b3c00">
        <di:waypoint x="256" y="150" />
        <di:waypoint x="310" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_01n4m2w_di" bpmnElement="Flow_01n4m2w" bioc:stroke="#6b3c00" color:border-color="#6b3c00">
        <di:waypoint x="410" y="150" />
        <di:waypoint x="480" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Participant_ChatBot_di" bpmnElement="Participant_ChatBot" isHorizontal="true">
        <dc:Bounds x="160" y="280" width="1210" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BotWelcome_di" bpmnElement="Task_BotWelcome" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="320" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_BotStart_di" bpmnElement="Event_BotStart" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="220" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel color:color="#6b3c00">
          <dc:Bounds x="200" y="358" width="77" height="14" />
        </bpmndi:BPMNLabel>
