{
  "name": "max-hackathon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "start": "node --use-system-ca src/main.ts",
    "me": "node --use-system-ca src/me.ts",
    "mock": "node scripts/mock.ts",
    "typecheck": "tsc && tsc -p tsconfig.web.json",
    "test": "vite build --logLevel warn && node --test test/*.test.ts"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
