<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.29.0">
  <bpmn:collaboration id="Collaboration_JointTest">
    <bpmn:participant id="Participant_Players" name="Игроки в чате MAX" processRef="Process_Players" />
    <bpmn:participant id="Participant_Chatbot" name="Чат-бот MAX" processRef="Process_Chatbot" />
    <bpmn:participant id="Participant_MiniApp" name="Мини-приложение" processRef="Process_MiniApp" />
    <bpmn:participant id="Participant_Backend" name="Backend продукта" processRef="Process_Backend" />
    <bpmn:messageFlow id="Flow_Msg_TestCommand" sourceRef="Task_Players_SendCommand" targetRef="Event_Chatbot_ReceiveCommand" />
    <bpmn:messageFlow id="Flow_Msg_TestCatalog" sourceRef="Task_Chatbot_SendCatalog" targetRef="Event_MiniApp_OpenCatalog" />
    <bpmn:messageFlow id="Flow_Msg_SelectTest" sourceRef="Task_MiniApp_SelectTest" targetRef="Event_Backend_Start" />
    <bpmn:messageFlow id="Flow_Msg_CreateSession" sourceRef="Task_MiniApp_LaunchJoint" targetRef="Task_Backend_CreateSession" />
    <bpmn:messageFlow id="Flow_Msg_InviteLink" sourceRef="Task_Backend_GenerateInvite" targetRef="Task_Chatbot_SendInvite" />
    <bpmn:messageFlow id="Flow_Msg_Player2Join" sourceRef="Task_MiniApp_Player2Join" targetRef="Task_Backend_ConfirmJoin" />
    <bpmn:messageFlow id="Flow_Msg_BothReady" sourceRef="Task_Backend_NotifyReady" targetRef="Event_MiniApp_BothReady" />
    <bpmn:messageFlow id="Flow_Msg_Answer1" sourceRef="Task_MiniApp_Player1Answer" targetRef="Task_Backend_CollectAnswers" />
    <bpmn:messageFlow id="Flow_Msg_Answer2" sourceRef="Task_MiniApp_Player2Answer" targetRef="Task_Backend_CollectAnswers" />
    <bpmn:messageFlow id="Flow_Msg_Result" sourceRef="Task_Backend_FormResult" targetRef="Task_MiniApp_ShowResult" />
    <bpmn:messageFlow id="Flow_Msg_ResultChat" sourceRef="Task_Backend_FormResult" targetRef="Task_Chatbot_SendResult" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Players" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Initiator" name="Инициатор сессии" />
      <bpmn:lane id="Lane_Player2" name="Второй игрок" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_Start_TestCommand" name="Сообщение /test в чате">
      <bpmn:outgoing>Flow_ToSendCommand</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="Task_Players_SendCommand" name="Инициатор: отправить /test">
      <bpmn:incoming>Flow_ToSendCommand</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterCommand</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Players_ForwardInvite" name="Переслать инвайт второму игроку">
      <bpmn:incoming>Flow_AfterCommand</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPlayer2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Player2_ReceiveInvite" name="Получить инвайт-ссылку">
      <bpmn:incoming>Flow_ToPlayer2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToOpenLink</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Player2_OpenLink" name="Открыть ссылку">
      <bpmn:incoming>Flow_ToOpenLink</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_End_Success" name="Общий результат получен">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToSendCommand" sourceRef="Event_Start_TestCommand" targetRef="Task_Players_SendCommand" />
    <bpmn:sequenceFlow id="Flow_AfterCommand" sourceRef="Task_Players_SendCommand" targetRef="Task_Players_ForwardInvite" />
    <bpmn:sequenceFlow id="Flow_ToPlayer2" sourceRef="Task_Players_ForwardInvite" targetRef="Task_Player2_ReceiveInvite" />
    <bpmn:sequenceFlow id="Flow_ToOpenLink" sourceRef="Task_Player2_ReceiveInvite" targetRef="Task_Player2_OpenLink" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Player2_OpenLink" targetRef="Event_End_Success" />
  </bpmn:process>
  <bpmn:process id="Process_Chatbot" isExecutable="false">
    <bpmn:startEvent id="Event_Chatbot_ReceiveCommand" name="Получена команда /test">
      <bpmn:outgoing>Flow_Bot_ToSendCatalog</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="Task_Chatbot_SendCatalog" name="Предложить открыть каталог тестов">
      <bpmn:incoming>Flow_Bot_ToSendCatalog</bpmn:incoming>
      <bpmn:outgoing>Flow_Bot_AfterCatalog</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Chatbot_SendInvite" name="Отправить инвайт-ссылку в чат">
      <bpmn:incoming>Flow_Bot_AfterCatalog</bpmn:incoming>
      <bpmn:outgoing>Flow_Bot_ToWait</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Chatbot_WaitJoin" name="Ожидание присоединения партнёра">
      <bpmn:incoming>Flow_Bot_ToWait</bpmn:incoming>
      <bpmn:outgoing>Flow_Bot_ToResult</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Chatbot_OfferSolo" name="Предложить одиночный режим">
      <bpmn:incoming>Flow_Bot_Timeout</bpmn:incoming>
      <bpmn:outgoing>Flow_Bot_ToEndCancelled</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Chatbot_SendResult" name="Отправить итог и кнопку «Поделиться»">
      <bpmn:incoming>Flow_Bot_ToResult</bpmn:incoming>
      <bpmn:outgoing>Flow_Bot_ToEndSuccess</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_End_Cancelled" name="Тест не состоялся">
      <bpmn:incoming>Flow_Bot_ToEndCancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_End_Bot_Success" name="Результат отправлен">
      <bpmn:incoming>Flow_Bot_ToEndSuccess</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Event_Timeout_NoJoin" name="Партнёр не присоединился за 15 мин" attachedToRef="Task_Chatbot_WaitJoin">
      <bpmn:outgoing>Flow_Bot_Timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Bot_ToSendCatalog" sourceRef="Event_Chatbot_ReceiveCommand" targetRef="Task_Chatbot_SendCatalog" />
    <bpmn:sequenceFlow id="Flow_Bot_AfterCatalog" sourceRef="Task_Chatbot_SendCatalog" targetRef="Task_Chatbot_SendInvite" />
    <bpmn:sequenceFlow id="Flow_Bot_ToWait" sourceRef="Task_Chatbot_SendInvite" targetRef="Task_Chatbot_WaitJoin" />
    <bpmn:sequenceFlow id="Flow_Bot_ToResult" sourceRef="Task_Chatbot_WaitJoin" targetRef="Task_Chatbot_SendResult" />
    <bpmn:sequenceFlow id="Flow_Bot_Timeout" sourceRef="Event_Timeout_NoJoin" targetRef="Task_Chatbot_OfferSolo" />
    <bpmn:sequenceFlow id="Flow_Bot_ToEndCancelled" sourceRef="Task_Chatbot_OfferSolo" targetRef="Event_End_Cancelled" />
    <bpmn:sequenceFlow id="Flow_Bot_ToEndSuccess" sourceRef="Task_Chatbot_SendResult" targetRef="Event_End_Bot_Success" />
  </bpmn:process>
  <bpmn:process id="Process_MiniApp" isExecutable="false">
    <bpmn:startEvent id="Event_MiniApp_OpenCatalog" name="Открыт каталог тестов">
      <bpmn:outgoing>Flow_App_ToSelect</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="Task_MiniApp_SelectTest" name="Выбрать тест из каталога">
      <bpmn:incoming>Flow_App_ToSelect</bpmn:incoming>
      <bpmn:outgoing>Flow_App_ToCheckMode</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CheckJointMode" name="Тест поддерживает совместное прохождение?" default="Flow_App_YesJoint">
      <bpmn:incoming>Flow_App_ToCheckMode</bpmn:incoming>
      <bpmn:outgoing>Flow_App_YesJoint</bpmn:outgoing>
      <bpmn:outgoing>Flow_App_NoJoint</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_MiniApp_LaunchJoint" name="Запустить совместную сессию">
      <bpmn:incoming>Flow_App_YesJoint</bpmn:incoming>
      <bpmn:outgoing>Flow_App_ToWaitPlayer2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_MiniApp_WaitPlayer2" name="Экран ожидания партнёра">
      <bpmn:incoming>Flow_App_ToWaitPlayer2</bpmn:incoming>
      <bpmn:outgoing>Flow_App_ToPlayer2Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_MiniApp_Player2Join" name="Второй игрок присоединяется">
      <bpmn:incoming>Flow_App_ToPlayer2Join</bpmn:incoming>
      <bpmn:outgoing>Flow_App_ToReadyEvent</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_MiniApp_BothReady" name="Партнёр готов">
      <bpmn:incoming>Flow_App_ToReadyEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_App_ToTestScreen</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_MiniApp_TestScreen" name="Тестовый экран (синхронные раунды)">
      <bpmn:incoming>Flow_App_ToTestScreen</bpmn:incoming>
      <bpmn:incoming>Flow_App_NextQuestion</bpmn:incoming>
      <bpmn:outgoing>Flow_App_ToAnswerFork</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_AnswerFork" name="Оба игрока отвечают параллельно">
      <bpmn:incoming>Flow_App_ToAnswerFork</bpmn:incoming>
      <bpmn:outgoing>Flow_App_ToAnswer1</bpmn:outgoing>
      <bpmn:outgoing>Flow_App_ToAnswer2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_MiniApp_Player1Answer" name="Игрок 1 отвечает">
      <bpmn:incoming>Flow_App_ToAnswer1</bpmn:incoming>
      <bpmn:outgoing>Flow_App_FromAnswer1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_MiniApp_SavePartial" name="Сохранить частичный результат">
      <bpmn:incoming>Flow_App_ToSavePartial</bpmn:incoming>
      <bpmn:incoming>Flow_App_ToSavePartial2</bpmn:incoming>
      <bpmn:outgoing>Flow_App_ToEndInterrupted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_MiniApp_Player2Answer" name="Игрок 2 отвечает">
      <bpmn:incoming>Flow_App_ToAnswer2</bpmn:incoming>
      <bpmn:outgoing>Flow_App_FromAnswer2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_MiniApp_PauseSession" name="Сессия на паузе, напоминание в чат">
      <bpmn:incoming>Flow_App_ToPauseNotify</bpmn:incoming>
      <bpmn:incoming>Flow_App_ToPauseNotify2</bpmn:incoming>
      <bpmn:outgoing>Flow_App_ReturnFromPause</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_End_Interrupted" name="Тест прерван">
      <bpmn:incoming>Flow_App_ToEndInterrupted</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_MiniApp_ShowResult" name="Общий экран результата">
      <bpmn:incoming>Flow_App_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_1atusb3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_End_App_Success" name="Результат отображён">
      <bpmn:incoming>Flow_1atusb3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gateway_AnswerJoin" name="Сбор обоих ответов">
      <bpmn:incoming>Flow_App_FromAnswer1</bpmn:incoming>
      <bpmn:incoming>Flow_App_FromAnswer2</bpmn:incoming>
      <bpmn:incoming>Flow_App_ReturnFromPause</bpmn:incoming>
      <bpmn:outgoing>Flow_App_ToCheckComplete</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_TestComplete" name="Все вопросы пройдены?" default="Flow_App_NextQuestion">
      <bpmn:incoming>Flow_App_ToCheckComplete</bpmn:incoming>
      <bpmn:outgoing>Flow_App_NextQuestion</bpmn:outgoing>
      <bpmn:outgoing>Flow_App_Complete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_End_Player2Timeout" name="Таймаут присоединения">
      <bpmn:incoming>Flow_App_ToTimeoutEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_End_SoloMode" name="Для одиночного режима — см. отдельный сценарий">
      <bpmn:incoming>Flow_App_NoJoint</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Event_PlayerLeft" name="Игрок 1 покинул окончательно" attachedToRef="Task_MiniApp_Player1Answer">
      <bpmn:outgoing>Flow_App_ToSavePartial</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_PlayerPaused" name="Игрок 1 отошёл" cancelActivity="false" attachedToRef="Task_MiniApp_Player1Answer">
      <bpmn:outgoing>Flow_App_ToPauseNotify</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_Player2JoinTimeout" name="Игрок 2 не присоединился за 5 мин" attachedToRef="Task_MiniApp_Player2Join">
      <bpmn:outgoing>Flow_App_ToTimeoutEnd</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_Player2Paused" name="Игрок 2 отошёл" cancelActivity="false" attachedToRef="Task_MiniApp_Player2Answer">
      <bpmn:outgoing>Flow_App_ToPauseNotify2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_Player2Left" name="Игрок 2 покинул окончательно" attachedToRef="Task_MiniApp_Player2Answer">
      <bpmn:outgoing>Flow_App_ToSavePartial2</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_App_ToSelect" sourceRef="Event_MiniApp_OpenCatalog" targetRef="Task_MiniApp_SelectTest" />
    <bpmn:sequenceFlow id="Flow_App_ToCheckMode" sourceRef="Task_MiniApp_SelectTest" targetRef="Gateway_CheckJointMode" />
    <bpmn:sequenceFlow id="Flow_App_YesJoint" name="Да" sourceRef="Gateway_CheckJointMode" targetRef="Task_MiniApp_LaunchJoint" />
    <bpmn:sequenceFlow id="Flow_App_NoJoint" name="Нет" sourceRef="Gateway_CheckJointMode" targetRef="Event_End_SoloMode">
      <bpmn:conditionExpression>solo_mode</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_App_ToWaitPlayer2" sourceRef="Task_MiniApp_LaunchJoint" targetRef="Task_MiniApp_WaitPlayer2" />
    <bpmn:sequenceFlow id="Flow_App_ToPlayer2Join" sourceRef="Task_MiniApp_WaitPlayer2" targetRef="Task_MiniApp_Player2Join" />
    <bpmn:sequenceFlow id="Flow_App_ToReadyEvent" sourceRef="Task_MiniApp_Player2Join" targetRef="Event_MiniApp_BothReady" />
    <bpmn:sequenceFlow id="Flow_App_ToTestScreen" sourceRef="Event_MiniApp_BothReady" targetRef="Task_MiniApp_TestScreen" />
    <bpmn:sequenceFlow id="Flow_App_NextQuestion" name="Нет" sourceRef="Gateway_TestComplete" targetRef="Task_MiniApp_TestScreen" />
    <bpmn:sequenceFlow id="Flow_App_ToAnswerFork" sourceRef="Task_MiniApp_TestScreen" targetRef="Gateway_AnswerFork" />
    <bpmn:sequenceFlow id="Flow_App_ToAnswer1" sourceRef="Gateway_AnswerFork" targetRef="Task_MiniApp_Player1Answer" />
    <bpmn:sequenceFlow id="Flow_App_ToAnswer2" sourceRef="Gateway_AnswerFork" targetRef="Task_MiniApp_Player2Answer" />
    <bpmn:sequenceFlow id="Flow_App_FromAnswer1" sourceRef="Task_MiniApp_Player1Answer" targetRef="Gateway_AnswerJoin" />
    <bpmn:sequenceFlow id="Flow_App_ToSavePartial" sourceRef="Event_PlayerLeft" targetRef="Task_MiniApp_SavePartial" />
    <bpmn:sequenceFlow id="Flow_App_ToSavePartial2" sourceRef="Event_Player2Left" targetRef="Task_MiniApp_SavePartial" />
    <bpmn:sequenceFlow id="Flow_App_ToEndInterrupted" sourceRef="Task_MiniApp_SavePartial" targetRef="Event_End_Interrupted" />
    <bpmn:sequenceFlow id="Flow_App_FromAnswer2" sourceRef="Task_MiniApp_Player2Answer" targetRef="Gateway_AnswerJoin" />
    <bpmn:sequenceFlow id="Flow_App_ToPauseNotify" sourceRef="Event_PlayerPaused" targetRef="Task_MiniApp_PauseSession" />
    <bpmn:sequenceFlow id="Flow_App_ToPauseNotify2" sourceRef="Event_Player2Paused" targetRef="Task_MiniApp_PauseSession" />
    <bpmn:sequenceFlow id="Flow_App_ReturnFromPause" sourceRef="Task_MiniApp_PauseSession" targetRef="Gateway_AnswerJoin" />
    <bpmn:sequenceFlow id="Flow_App_Complete" name="Да" sourceRef="Gateway_TestComplete" targetRef="Task_MiniApp_ShowResult">
      <bpmn:conditionExpression>all_questions_done</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1atusb3" sourceRef="Task_MiniApp_ShowResult" targetRef="Event_End_App_Success" />
    <bpmn:sequenceFlow id="Flow_App_ToCheckComplete" sourceRef="Gateway_AnswerJoin" targetRef="Gateway_TestComplete" />
    <bpmn:sequenceFlow id="Flow_App_ToTimeoutEnd" sourceRef="Event_Player2JoinTimeout" targetRef="Event_End_Player2Timeout" />
  </bpmn:process>
  <bpmn:process id="Process_Backend" isExecutable="false">
    <bpmn:startEvent id="Event_Backend_Start" name="Запрос от мини-приложения">
      <bpmn:outgoing>Flow_Backend_Start</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="Task_Backend_CheckMode" name="Проверить режим теста">
      <bpmn:incoming>Flow_Backend_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Backend_ToCreate</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Backend_CreateSession" name="Создать сессию (статус: ожидание партнёра)">
      <bpmn:incoming>Flow_Backend_ToCreate</bpmn:incoming>
      <bpmn:outgoing>Flow_Backend_ToInvite</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Backend_GenerateInvite" name="Сгенерировать инвайт-ссылку">
      <bpmn:incoming>Flow_Backend_ToInvite</bpmn:incoming>
      <bpmn:outgoing>Flow_Backend_ToConfirm</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Backend_ConfirmJoin" name="Подтвердить присоединение второго игрока">
      <bpmn:incoming>Flow_Backend_ToConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Backend_ToNotify</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Backend_NotifyReady" name="Уведомить обоих: партнёр готов">
      <bpmn:incoming>Flow_Backend_ToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_Backend_ToCollect</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Backend_CollectAnswers" name="Собрать ответы обоих игроков">
      <bpmn:incoming>Flow_Backend_ToCollect</bpmn:incoming>
      <bpmn:incoming>Flow_Backend_RetryCollect</bpmn:incoming>
      <bpmn:outgoing>Flow_Backend_ToCheckAnswers</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AnswersReceived" name="Варианты получены от обоих?" default="Flow_Backend_NextRound">
      <bpmn:incoming>Flow_Backend_ToCheckAnswers</bpmn:incoming>
      <bpmn:outgoing>Flow_Backend_NextRound</bpmn:outgoing>
      <bpmn:outgoing>Flow_Backend_WaitMore</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Backend_CalculateTypes" name="Определить тип каждого игрока по весам">
      <bpmn:incoming>Flow_Backend_NextRound</bpmn:incoming>
      <bpmn:outgoing>Flow_Backend_ToFormResult</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Backend_FormResult" name="Сформировать общий результат (типы + карта совместимости)">
      <bpmn:incoming>Flow_Backend_ToFormResult</bpmn:incoming>
      <bpmn:outgoing>Flow_Backend_ToEndSuccess</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_End_Backend_Success" name="Результат сформирован">
      <bpmn:incoming>Flow_Backend_ToEndSuccess</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Backend_WaitAnswers" name="Ожидание ответа">
      <bpmn:incoming>Flow_Backend_WaitMore</bpmn:incoming>
      <bpmn:outgoing>Flow_Backend_RetryCollect</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_End_AnswerTimeout" name="Таймаут ожидания ответов">
      <bpmn:incoming>Flow_Backend_AnswerTimeout</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Event_AnswerTimeout" name="Таймаут ответа 2 мин" attachedToRef="Task_Backend_WaitAnswers">
      <bpmn:outgoing>Flow_Backend_AnswerTimeout</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Backend_Start" sourceRef="Event_Backend_Start" targetRef="Task_Backend_CheckMode" />
    <bpmn:sequenceFlow id="Flow_Backend_ToCreate" sourceRef="Task_Backend_CheckMode" targetRef="Task_Backend_CreateSession" />
    <bpmn:sequenceFlow id="Flow_Backend_ToInvite" sourceRef="Task_Backend_CreateSession" targetRef="Task_Backend_GenerateInvite" />
    <bpmn:sequenceFlow id="Flow_Backend_ToConfirm" sourceRef="Task_Backend_GenerateInvite" targetRef="Task_Backend_ConfirmJoin" />
    <bpmn:sequenceFlow id="Flow_Backend_ToNotify" sourceRef="Task_Backend_ConfirmJoin" targetRef="Task_Backend_NotifyReady" />
    <bpmn:sequenceFlow id="Flow_Backend_ToCollect" sourceRef="Task_Backend_NotifyReady" targetRef="Task_Backend_CollectAnswers" />
    <bpmn:sequenceFlow id="Flow_Backend_RetryCollect" sourceRef="Task_Backend_WaitAnswers" targetRef="Task_Backend_CollectAnswers" />
    <bpmn:sequenceFlow id="Flow_Backend_ToCheckAnswers" sourceRef="Task_Backend_CollectAnswers" targetRef="Gateway_AnswersReceived" />
    <bpmn:sequenceFlow id="Flow_Backend_NextRound" name="Да" sourceRef="Gateway_AnswersReceived" targetRef="Task_Backend_CalculateTypes" />
    <bpmn:sequenceFlow id="Flow_Backend_WaitMore" name="Нет" sourceRef="Gateway_AnswersReceived" targetRef="Task_Backend_WaitAnswers">
      <bpmn:conditionExpression>not_all_answered</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Backend_ToFormResult" sourceRef="Task_Backend_CalculateTypes" targetRef="Task_Backend_FormResult" />
    <bpmn:sequenceFlow id="Flow_Backend_ToEndSuccess" sourceRef="Task_Backend_FormResult" targetRef="Event_End_Backend_Success" />
    <bpmn:sequenceFlow id="Flow_Backend_AnswerTimeout" sourceRef="Event_AnswerTimeout" targetRef="Event_End_AnswerTimeout" />
  </bpmn:process>
